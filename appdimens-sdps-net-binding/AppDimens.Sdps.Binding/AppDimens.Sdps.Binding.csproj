<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Impede glob implícito de *.aar sob Jars/Reference (Compose/Window) pelo SDK Android -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Jars\Reference\**\*;Maven\**</DefaultItemExcludes>

    <!-- Compatível com apps net8–11 Android / MAUI Android.
         API level no TFM (34/35/36/37) é exigido pelos pacotes Xamarin.AndroidX.
         net11 só entra quando o SDK em uso é 11+ (evita NETSDK1139 no SDK 10). -->
    <TargetFrameworks>net8.0-android34.0;net9.0-android35.0;net10.0-android36.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '11.0'))">$(TargetFrameworks);net11.0-android37.0</TargetFrameworks>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <!-- Necessário quando o Manifest da AAR declara uses-sdk menor que o projeto -->
    <AndroidMinSdkVersion>24</AndroidMinSdkVersion>

    <!-- net8-android workload marcado EOL em SDKs novos — ainda suportamos consumidores net8 -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Biblioteca Java/Kotlin interoperável gerada pela tooling Android -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591;BG8605;BG8606;BG8401;NETSDK1202</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Jean Bodenberg</Authors>
    <Company />
    <Description>
      .NET Android binding for AppDimens SDP/HDP/WDP (`io.github.bodenberg:appdimens-sdps` 3.1.7).
      Targets net8.0-android through net11.0-android. Exposes Java-style APIs under Com.Appdimens.Sdps.Code
      (Kotlin @JvmStatic; foldables via AndroidX.Window) plus Com.Appdimens.Sdps.SdpsConfig for warmup /
      OnConfigurationChanged refresh. Jetpack Compose helpers are not practical from C# — see README.
    </Description>
    <Copyright>Copyright © Jean Bodenberg</Copyright>
    <PackageReleaseNotes>
      NuGet 3.6.0: Embedded AAR Maven io.github.bodenberg:appdimens-sdps 3.1.7; multi-target
      net8.0-android / net9.0-android / net10.0-android / net11.0-android; SdpsConfig helper for
      warmup and configuration-change dimension refresh; AndroidX/Kotlin pins aligned to AAR POM.
      Android library: https://github.com/bodenberg/appdimens-sdps · Binding: https://github.com/bodenberg/appdimens-net-binding
    </PackageReleaseNotes>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/bodenberg/appdimens</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/bodenberg/appdimens-sdps</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>android;binding;maui;xamarin;appdimens;sdp;hdp;wdp;kotlin;window;foldable;net8;net9;net10;net11</PackageTags>

    <!-- Empacota o mesmo assembly principal (o binding) -->
    <PackageId>Bodenberg.AppDimens.Sdps</PackageId>
    <Version>3.6.0</Version>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <!-- AAR publicada no Maven Central: appdimens-sdps-3.1.7 -->
    <AndroidLibrary Bind="true" Include="Jars\appdimens-sdps-3.1.7.aar" />

    <TransformFile Include="Transforms\Metadata.xml" />
    <TransformFile Include="Transforms\EnumFields.xml" />
    <TransformFile Include="Transforms\EnumMethods.xml" />

    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <!-- Metadados Maven de referência (não entram no assembly) -->
    <None Include="Maven\appdimens-sdps-3.1.7.pom" />
    <None Include="Maven\appdimens-sdps-3.1.7.module" />
    <None Include="Maven\appdimens-sdps-3.1.7-javadoc.jar" />
  </ItemGroup>

  <!-- net8: versões estáveis compatíveis com o TFM mais antigo -->
  <ItemGroup Condition="$(TargetFramework.StartsWith('net8.0-android'))">
    <PackageReference Include="Xamarin.Kotlin.StdLib" Version="2.2.21" />
    <PackageReference Include="Xamarin.AndroidX.Core" Version="1.16.0.3" />
    <PackageReference Include="Xamarin.AndroidX.Window" Version="1.4.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime" Version="2.9.4" />
  </ItemGroup>

  <!-- net9: versões intermediárias compatíveis com net9 -->
  <ItemGroup Condition="$(TargetFramework.StartsWith('net9.0-android'))">
    <PackageReference Include="Xamarin.Kotlin.StdLib" Version="2.3.21" />
    <PackageReference Include="Xamarin.AndroidX.Core" Version="1.17.0.2" />
    <PackageReference Include="Xamarin.AndroidX.Window" Version="1.5.1.2" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime" Version="2.10.0.2" />
  </ItemGroup>

  <!-- net10 / net11: alinhados ao POM Gradle appdimens-sdps 3.1.7; NuGet pins usam os pacotes Xamarin publicados correspondentes -->
  <ItemGroup Condition="$(TargetFramework.StartsWith('net10.0-android')) Or $(TargetFramework.StartsWith('net11.0-android'))">
    <PackageReference Include="Xamarin.Kotlin.StdLib" Version="2.4.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Core" Version="1.19.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Window" Version="1.5.1.3" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime" Version="2.11.0.1" />
  </ItemGroup>

</Project>
