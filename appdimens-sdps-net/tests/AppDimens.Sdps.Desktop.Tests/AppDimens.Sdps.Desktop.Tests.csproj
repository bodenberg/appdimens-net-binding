<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs on Windows only (WPF / Windows Forms need a desktop session); compiles everywhere. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>AppDimens.Sdps.Desktop.Tests</RootNamespace>
    <!-- System.Windows.Forms and WPF both define e.g. Application / Size. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- WPF bindings need real cultures (the repo default is invariant). -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AppDimens.Sdps.Wpf\AppDimens.Sdps.Wpf.csproj" />
    <ProjectReference Include="..\..\src\AppDimens.Sdps.WinForms\AppDimens.Sdps.WinForms.csproj" />
    <ProjectReference Include="..\..\src\AppDimens.Maui\AppDimens.Maui.csproj" />
    <ProjectReference Include="..\..\src\AppDimens.Maui.Core\AppDimens.Maui.Core.csproj" />
  </ItemGroup>
</Project>
