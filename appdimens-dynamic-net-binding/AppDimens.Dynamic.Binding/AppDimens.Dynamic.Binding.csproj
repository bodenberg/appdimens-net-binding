<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Impede glob implícito de *.aar sob Jars/Reference (Compose/Window) pelo SDK Android -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Jars\Reference\**\*;Maven\**</DefaultItemExcludes>

    <!-- Compatível com apps net8–11 Android / MAUI Android.
         API level no TFM (34/35/36/37) é exigido pelos pacotes Xamarin.AndroidX.
         net11 só entra quando o SDK em uso é 11+ (evita NETSDK1139 no SDK 10). -->
    <TargetFrameworks>net8.0-android34.0;net9.0-android35.0;net10.0-android36.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '11.0'))">$(TargetFrameworks);net11.0-android37.0</TargetFrameworks>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <!-- Necessário quando o Manifest da AAR declara uses-sdk menor que o projeto -->
    <AndroidMinSdkVersion>24</AndroidMinSdkVersion>

    <!-- net8-android workload marcado EOL em SDKs novos — ainda suportamos consumidores net8 -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591;BG8605;BG8606;BG8401</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Jean Bodenberg</Authors>
    <Company />
    <Description>
      .NET Android binding for AppDimens Dynamic (`io.github.bodenberg:appdimens-dynamic`).
      Public Kotlin APIs with `@JvmStatic` appear under **`Com.Appdimens.Dynamic`** (e.g. `Com.Appdimens.Dynamic.Code`).
      Jetpack Compose and Wear helpers may reference Compose types; imperative C# surface follows the Views/code package — see README.
    </Description>
    <Copyright>Copyright © Jean Bodenberg</Copyright>
    <PackageReleaseNotes>
      NuGet 3.5.1.4: Target net10.0-android; Xamarin AndroidX/DataStore 1.2.1 (DimenCache, aligned with Maven). Embedded AAR unchanged: Maven io.github.bodenberg:appdimens-dynamic 3.1.5.
      Android library: https://github.com/bodenberg/appdimens-dynamic · Binding: https://github.com/bodenberg/appdimens-net-binding
    </PackageReleaseNotes>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/bodenberg/appdimens</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/bodenberg/appdimens-dynamic</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>android;binding;maui;xamarin;appdimens;dynamic;dp;sp;responsive;kotlin;window</PackageTags>

    <PackageId>Bodenberg.AppDimens.Dynamic</PackageId>
    <Version>3.5.1.4</Version>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <AndroidLibrary Bind="true" Include="Jars\appdimens-dynamic-3.1.5.aar" />

    <TransformFile Include="Transforms\Metadata.xml" />
    <TransformFile Include="Transforms\EnumFields.xml" />
    <TransformFile Include="Transforms\EnumMethods.xml" />

    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Runtime deps do POM Gradle (appdimens-dynamic 3.1.5); DataStore é obrigatório para DimenCache. -->
  <ItemGroup>
    <PackageReference Include="Xamarin.Kotlin.StdLib" Version="2.3.21" />
    <PackageReference Include="Xamarin.AndroidX.Core" Version="1.18.0" />
    <PackageReference Include="Xamarin.AndroidX.Window" Version="1.5.1.2" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime" Version="2.10.0.2" />
    <!-- Maven appdimens-dynamic usa datastore-preferences 1.2.1 -->
    <PackageReference Include="Xamarin.AndroidX.DataStore.Preferences" Version="1.2.1" />
  </ItemGroup>

  <!-- Generator omits `new` on nested sealed subclasses' _members (CS0108). Patch after bind. -->
  <!-- NOTE: The previous sed-based patch was broken on Linux (wrong class name, path separators, regex terminator).
       If CS0108 reappears on ResizeBound, re-add a corrected post-build fix targeting JniPeerMembers with Linux paths. -->

</Project>
