<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Prefer -f net10.0-android36.0; net11 entra só com SDK 11+ -->
    <TargetFrameworks>net8.0-android34.0;net9.0-android35.0;net10.0-android36.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '11.0'))">$(TargetFrameworks);net11.0-android37.0</TargetFrameworks>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <NoWarn>$(NoWarn);NETSDK1202</NoWarn>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AndroidMinSdkVersion>24</AndroidMinSdkVersion>
    <ApplicationId>com.appdimens.dynamic.smoke</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>3.6.0</ApplicationDisplayVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AppDimens.Dynamic.Binding\AppDimens.Dynamic.Binding.csproj" />
  </ItemGroup>
</Project>
