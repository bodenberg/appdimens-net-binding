<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '11.0'))">$(TargetFrameworks);net11.0</TargetFrameworks>
    <RootNamespace>AppDimens.Net.Sdk</RootNamespace>
    <AssemblyName>AppDimens.Net.Sdk</AssemblyName>
    <PackageId>AppDimens.Net.Sdk</PackageId>
    <Description>AppDimens .NET meta-package ("BOM"): pulls the principal library plus every strategy module with a single reference.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AppDimens.Net\AppDimens.Net.csproj" />
    <ProjectReference Include="..\AppDimens.Net.Percent\AppDimens.Net.Percent.csproj" />
