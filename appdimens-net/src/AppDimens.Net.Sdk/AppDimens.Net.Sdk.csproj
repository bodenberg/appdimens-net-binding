    <ProjectReference Include="..\AppDimens.Net.Fluid\AppDimens.Net.Fluid.csproj" />
    <ProjectReference Include="..\AppDimens.Net.Auto\AppDimens.Net.Auto.csproj" />
    <ProjectReference Include="..\AppDimens.Net.Density\AppDimens.Net.Density.csproj" />
    <ProjectReference Include="..\AppDimens.Net.Diagonal\AppDimens.Net.Diagonal.csproj" />
    <ProjectReference Include="..\AppDimens.Net.Fill\AppDimens.Net.Fill.csproj" />
    <ProjectReference Include="..\AppDimens.Net.Fit\AppDimens.Net.Fit.csproj" />
    <ProjectReference Include="..\AppDimens.Net.Interpolated\AppDimens.Net.Interpolated.csproj" />
    <ProjectReference Include="..\AppDimens.Net.Logarithmic\AppDimens.Net.Logarithmic.csproj" />
    <ProjectReference Include="..\AppDimens.Net.Perimeter\AppDimens.Net.Perimeter.csproj" />
    <ProjectReference Include="..\AppDimens.Net.Resize\AppDimens.Net.Resize.csproj" />
    <ProjectReference Include="..\AppDimens.Net.Units\AppDimens.Net.Units.csproj" />
  </ItemGroup>

</Project>
