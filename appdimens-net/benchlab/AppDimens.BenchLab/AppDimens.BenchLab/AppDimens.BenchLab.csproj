<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">net10.0-android36.1;net8.0-android;net8.0-ios;net8.0-maccatalyst;net8.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('linux'))">net10.0-android36.1</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AppDimens.BenchLab</RootNamespace>

    <SupportedOSPlatformVersion Condition="$(TargetPlatformIdentifier) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetPlatformIdentifier) == 'ios'">14.2</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetPlatformIdentifier) == 'maccatalyst'">14.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetPlatformIdentifier) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$(TargetPlatformIdentifier) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

    <ApplicationTitle>AppDimens BenchLab</ApplicationTitle>
    <ApplicationId>com.bodenberg.appdimens.benchlab</ApplicationId>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="MauiProgram.cs" />
    <Compile Include="Platforms\**\*.cs" />
    <Compile Include="..\AppDimens.BenchLab.Ui\BenchMainPage.cs"
             Exclude="..\AppDimens.BenchLab.Ui\bin\**;..\AppDimens.BenchLab.Ui\obj\**"
             LinkBase="SharedUi" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AppDimens.BenchLab.Core\AppDimens.BenchLab.Core.csproj" />
    <ProjectReference Include="..\..\..\src\AppDimens.Net.Sdk\AppDimens.Net.Sdk.csproj" />
    <ProjectReference Include="..\..\..\src\AppDimens.Net.Maui\AppDimens.Net.Maui.csproj" />
  </ItemGroup>

</Project>
